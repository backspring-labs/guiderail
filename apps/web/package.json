{
	"name": "@guiderail/web",
	"version": "0.8.1",
	"private": true,
	"description": "GuideRail web UI — terrain canvas, detail panels, guided route bar",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -b",
		"test:e2e": "playwright test",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build --disable-telemetry"
	},
	"dependencies": {
		"@guiderail/core": "workspace:*",
		"@xstate/react": "^5.0.0",
		"@xyflow/react": "^12.12.1",
		"elkjs": "^0.12.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"xstate": "^5.33.4",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.1",
		"@storybook/addon-essentials": "^8.6.19",
		"@storybook/react": "^8.6.19",
		"@storybook/react-vite": "^8.6.19",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitest/coverage-v8": "^4.1.12",
		"jsdom": "^26.0.0",
		"storybook": "^8.6.19",
		"vite": "^6.4.6",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	}
}
