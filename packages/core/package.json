{
	"name": "@guiderail/core",
	"version": "0.8.0",
	"description": "GuideRail headless kernel — canonical domain model, state machines, context synchronization",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/backspring-labs/guiderail.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/backspring-labs/guiderail/tree/main/packages/core#readme",
	"bugs": {
		"url": "https://github.com/backspring-labs/guiderail/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./entities": {
			"import": "./dist/entities/index.js",
			"types": "./dist/entities/index.d.ts"
		},
		"./graph": {
			"import": "./dist/graph/index.js",
			"types": "./dist/graph/index.d.ts"
		},
		"./machines": {
			"import": "./dist/machines/index.js",
			"types": "./dist/machines/index.d.ts"
		},
		"./context": {
			"import": "./dist/context/index.js",
			"types": "./dist/context/index.d.ts"
		},
		"./perspective": {
			"import": "./dist/perspective/index.js",
			"types": "./dist/perspective/index.d.ts"
		},
		"./adapters": {
			"import": "./dist/adapters/index.js",
			"types": "./dist/adapters/index.d.ts"
		},
		"./indexing": {
			"import": "./dist/indexing/index.js",
			"types": "./dist/indexing/index.d.ts"
		},
		"./provenance": {
			"import": "./dist/provenance/index.js",
			"types": "./dist/provenance/index.d.ts"
		},
		"./demo": {
			"import": "./dist/demo/index.js",
			"types": "./dist/demo/index.d.ts"
		},
		"./content": {
			"import": "./dist/content/index.js",
			"types": "./dist/content/index.d.ts"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.test.json",
		"check": "biome check .",
		"check:fix": "biome check --fix ."
	},
	"dependencies": {
		"xstate": "^5.33.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.12",
		"vitest": "^4.1.12"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	}
}
